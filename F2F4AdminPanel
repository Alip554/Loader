-- F2 Key Press Function
local function pressF2()
	-- Method 1: Using VirtualInputManager (Executor Specific)
	pcall(function()
		local VirtualInputManager = game:GetService("VirtualInputManager")
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F2, false, game)
		wait(0.1)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F2, false, game)
	end)
	
	-- Method 2: Trigger InputBegan/InputEnded events
	pcall(function()
		local inputObject = {
			KeyCode = Enum.KeyCode.F2,
			UserInputType = Enum.UserInputType.Keyboard
		}
		
		-- Simulate key press
		for _, connection in pairs(getconnections(UserInputService.InputBegan)) do
			connection:Fire(inputObject, false)
		end
		
		wait(0.1)
		
		-- Simulate key release
		for _, connection in pairs(getconnections(UserInputService.InputEnded)) do
			connection:Fire(inputObject, false)
		end
	end)
	
	-- Visual Feedback
	f2Button.Text = "F2 Pressed!"
	wait(0.5)
	f2Button.Text = "Press F2"
end

