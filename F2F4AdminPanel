	tween:Play()
end)

-- Minimize Button Click
minimizeButton.MouseButton1Click:Connect(function()
	if not isMinimized then
		local tween = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Size = UDim2.new(0, 200, 0, 35)})
		tween:Play()
		isMinimized = true
		minimizeButton.Text = "+"
	else
		local tween = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Size = UDim2.new(0, 200, 0, 175)})
		tween:Play()
		isMinimized = false
		minimizeButton.Text = "−"
	end
end)

