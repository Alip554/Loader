local function isKeyExpired()
    if not (isfile and isfile(KEY_DATE_FILE)) then return false end
    local raw = readfile(KEY_DATE_FILE)
    local savedTime = tonumber(raw)
    if not savedTime then return true end
    local elapsed = os.time() - savedTime
    local elapsedDays = elapsed / 86400
    return elapsedDays >= KEY_EXPIRY_DAYS
end

local function loadSavedKey()
