    Animate.idle.Animation1.AnimationId  = pack.idle1
    Animate.idle.Animation2.AnimationId  = pack.idle2
    Animate.walk.WalkAnim.AnimationId    = pack.walk
    Animate.run.RunAnim.AnimationId      = pack.run
    Animate.jump.JumpAnim.AnimationId    = pack.jump
    Animate.fall.FallAnim.AnimationId    = pack.fall
    Animate.climb.ClimbAnim.AnimationId  = pack.climb
    Animate.swim.Swim.AnimationId        = pack.swim
    Animate.swimidle.SwimIdle.AnimationId = pack.swimidle

    -- Pre-load track jump & fall custom sekarang supaya siap saat dibutuhkan
    local animator = Humanoid:FindFirstChildOfClass("Animator")
    if animator then
        if customJumpTrack then pcall(function() customJumpTrack:Stop(0) end) end
        if customFallTrack then pcall(function() customFallTrack:Stop(0) end) end
        customJumpTrack = loadCustomTrack(animator, pack.jump)
        customFallTrack = loadCustomTrack(animator, pack.fall)
    end

    -- Stop semua track Animate lama supaya reload
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            if track ~= customJumpTrack and track ~= customFallTrack then
                track:Stop(0)
            end
        end
    end
    Animate.Enabled = false
    task.defer(function() Animate.Enabled = true end)
end

local function RestoreOriginal()
    for anim, id in pairs(OriginalAnimations) do
        if anim and anim:IsA("Animation") then
            anim.AnimationId = id
        end
    end
    OriginalAnimations = {}
end

