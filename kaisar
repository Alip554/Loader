local function setupCopyAvatarTab(Window, WindUI)
    local CATab = Window:Tab({
        Title = "CopyAvatar",
        Icon  = "user-round-check",
    })

    CATab:Section({ Title = "KaisarHub | Copy Avatar" })
    CATab:Space()

    local selectedPlayer = nil
    local originalDesc   = nil

    -- Simpan desc asli saat tab dibuka
    task.spawn(function()
        local ok, desc = pcall(function()
            return PlayersService:GetHumanoidDescriptionFromUserId(LocalPlayer.UserId)
        end)
        if ok and desc then originalDesc = desc end
    end)

    -- Info paragraph (diupdate saat pilih player)
    local infoText = CATab:Paragraph({
        Title = "Player Info",
        Desc  = "Belum ada player dipilih.",
    })

    CATab:Space()

    -- Fungsi notify
    local function Sukses(icon, msg)
        WindUI:Notify({ Title = "CopyAvatar", Content = msg, Icon = icon == "done" and "check" or "shield-x", Duration = 4 })
    end

    -- Fungsi apply desc
    local function applyDesc(hum, desc)
        local applied = false
        if hum.ApplyDescriptionClientServer then
            applied = pcall(function() hum:ApplyDescriptionClientServer(desc) end)
        end
        if not applied then
            applied = pcall(function() hum:ApplyDescription(desc) end)
        end
        return applied
    end

    -- Fungsi hapus aksesoris
    local function stripChar(char)
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Accessory") or item:IsA("Hat") or item:IsA("Shirt")
            or item:IsA("Pants") or item:IsA("ShirtGraphic") then
                item:Destroy()
            end
        end
    end

    -- Fungsi copy avatar
    local function copyAvatarFromPlayer(targetPlr)
        if not targetPlr or not targetPlr.UserId then
            Sukses("error", "Tidak ada player yang dipilih.")
            return
        end
        if not LocalPlayer.Character then
            Sukses("error", "Karakter kamu belum dimuat.")
            return
        end
        local userId = targetPlr.UserId
        local okDesc, humanoidDesc = pcall(function()
            return PlayersService:GetHumanoidDescriptionFromUserId(userId)
        end)
        if not okDesc or not humanoidDesc then
            Sukses("error", "Gagal mengambil avatar dari player.")
            return
        end
        local char = LocalPlayer.Character
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not hum then Sukses("error", "Humanoid tidak ditemukan.") return end
        stripChar(char)
        task.wait(0.2)
        if applyDesc(hum, humanoidDesc) then
            Sukses("done", "Avatar berhasil disalin dari " .. targetPlr.Name .. "!")
        else
            Sukses("error", "Game membatasi perubahan avatar.")
        end
    end

    -- Dropdown list player
    local function getPlayerNames()
        local names = {}
        for _, plr in ipairs(PlayersService:GetPlayers()) do
            if plr ~= LocalPlayer then table.insert(names, plr.Name) end
        end
        if #names == 0 then table.insert(names, "(kosong)") end
        return names
    end

    local playerNames = getPlayerNames()
    -- Set default selected
    if playerNames[1] ~= "(kosong)" then
        selectedPlayer = PlayersService:FindFirstChild(playerNames[1])
    end

    CATab:Dropdown({
        Title    = "Select Player",
        Desc     = "Pilih player yang avatarnya ingin disalin",
        Icon     = "users",
        Values   = playerNames,
        Default  = playerNames[1],
        Callback = function(val)
            selectedPlayer = PlayersService:FindFirstChild(val)
            -- Update info paragraph
            if selectedPlayer then
                local uid  = selectedPlayer.UserId
                local nick = selectedPlayer.DisplayName
                pcall(function()
                    infoText:Set({
                        Title = "Player targeted",
                        Desc  = "User: " .. selectedPlayer.Name
                            .. "\nNick: " .. nick
                            .. "\nID: "   .. uid,
                    })
                end)
            end
        end,
    })

    -- Update info untuk player default
    if selectedPlayer then
        pcall(function()
            infoText:Set({
                Title = "Player targeted",
                Desc  = "User: " .. selectedPlayer.Name
                    .. "\nNick: " .. selectedPlayer.DisplayName
                    .. "\nID: "   .. selectedPlayer.UserId,
            })
        end)
    end

    CATab:Space()

    CATab:Button({
        Title    = "Copy Avatar",
        Desc     = "Salin avatar dari player yang dipilih",
        Icon     = "user-round-check",
        Callback = function()
            task.spawn(function() copyAvatarFromPlayer(selectedPlayer) end)
        end,
    })

    CATab:Button({
        Title    = "Reset Avatar",
        Desc     = "Kembalikan avatar ke tampilan asli kamu",
        Icon     = "rotate-ccw",
        Callback = function()
            task.spawn(function()
                local desc = originalDesc
                if not desc then
                    local ok, d = pcall(function()
                        return PlayersService:GetHumanoidDescriptionFromUserId(LocalPlayer.UserId)
                    end)
                    if ok and d then desc = d
                    else
                        WindUI:Notify({ Title = "Gagal", Content = "Tidak bisa load avatar asli.", Icon = "shield-x", Duration = 3 })
                        return
                    end
                end
                local char = LocalPlayer.Character
                local hum  = char and char:FindFirstChildOfClass("Humanoid")
                if not hum then
                    WindUI:Notify({ Title = "Gagal", Content = "Humanoid tidak ditemukan.", Icon = "shield-x", Duration = 3 })
                    return
                end
                stripChar(char)
                task.wait(0.2)
                if applyDesc(hum, desc) then
                    WindUI:Notify({ Title = "Reset Avatar", Content = "Avatar dikembalikan ke asli!", Icon = "check", Duration = 3 })
                else
                    WindUI:Notify({ Title = "Gagal", Content = "Game membatasi perubahan avatar.", Icon = "shield-x", Duration = 3 })
                end
            end)
        end,
    })
end

local function setupAnimTab(Window, WindUI)
    local AnimTab = Window:Tab({
        Title = "Animation",
        Icon  = "zap",
    })

    AnimTab:Section({ Title = "Run Animations" })
    AnimTab:Space()

    local animationInteracted = {}

    for i, pack in ipairs(RunAnimations) do
        animationInteracted[pack.name] = false

        local tog = AnimTab:Toggle({
            Title    = pack.name,
            Desc     = "Apply " .. pack.name,
            Icon     = "zap",
            Type     = "Checkbox",
            Value    = false,
            Callback = function(state)
                local Char = LocalPlayer.Character
                if Char and Char:FindFirstChild("Animate") and Char:FindFirstChild("Humanoid") then
                    local Animate = Char.Animate
                    local Humanoid = Char.Humanoid

                    if state then
                        -- Matiin toggle lain
                        for _, otherPack in ipairs(RunAnimations) do
                            if otherPack.name ~= pack.name and animationInteracted[otherPack.name] then
                                animationInteracted[otherPack.name] = false
                                if toggleObjects[otherPack.name] then
                                    toggleObjects[otherPack.name]:Set(false)
                                end
                            end
                        end

                        SaveOriginal(Animate)
                        ApplyAnimation(Animate, Humanoid, pack)
                        currentAnimationActive = pack.name
                        animationInteracted[pack.name] = true

                        WindUI:Notify({
                            Title    = pack.name,
                            Content  = "Animation applied!",
                            Icon     = "check",
                            Duration = 3,
                        })
                    else
                        RestoreOriginal()
                        currentAnimationActive = nil
                        if animationInteracted[pack.name] then
                            animationInteracted[pack.name] = false
                            WindUI:Notify({
                                Title    = pack.name,
                                Content  = "Animation disabled!",
                                Icon     = "x",
                                Duration = 3,
                            })
                        end
                    end
                else
                    if state then
                        WindUI:Notify({
                            Title    = "Error",
                            Content  = "Character not found!",
                            Icon     = "shield-x",
                            Duration = 3,
                        })
                    end
                end
            end
        })

        toggleObjects[pack.name] = tog

        if i % 6 == 0 and i < #RunAnimations then
            AnimTab:Space()
        end
    end
    setupCopyAvatarTab(Window, WindUI)
    setupSettingsTab(Window, WindUI)
    setupDevTab(Window, WindUI)
end

