-- Height helpers
local function aw_getCurrentHeight()
    local c = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hum = c:WaitForChild("Humanoid")
    return hum.HipHeight + (c:FindFirstChild("Head") and c.Head.Size.Y or 2)
end

local function aw_adjustRoute(frames)
    local adjusted = {}
    local offsetY = aw_getCurrentHeight() - DEFAULT_HEIGHT
    for _, cf in ipairs(frames) do
        local pos = cf.Position
        local rot = cf - pos
        table.insert(adjusted, CFrame.new(Vector3.new(pos.X, pos.Y + offsetY, pos.Z)) * rot)
    end
    return adjusted
end

local function aw_removeDuplicates(frames, tolerance)
    tolerance = tolerance or 0.01
    if #frames < 2 then return frames end
    local out = { frames[1] }
    for i = 2, #frames do
        local prev, curr = frames[i-1], frames[i]
        local pd = (prev.Position - curr.Position).Magnitude
        local rd = ((prev - prev.Position).Position - (curr - curr.Position).Position).Magnitude
        if pd > tolerance or rd > tolerance then
            table.insert(out, curr)
        end
    end
    return out
end

local function aw_applyIntervalRot(cf)
    if intervalFlip then
        local pos = cf.Position
        return CFrame.new(pos) * (cf - pos) * CFrame.Angles(0, math.pi, 0)
    end
    return cf
end

local function aw_loadRoute(url)
    local ok, result = pcall(function()
        return loadstring(httpGet(url))()
    end)
    if ok and type(result) == "table" then
        return aw_adjustRoute(aw_removeDuplicates(result, 0.01))
    end
    return {}
end

local function aw_getNearestIdx(frames)
    local idx, dist = 1, math.huge
    if aw_hrp then
        local pos = aw_hrp.Position
        for i, cf in ipairs(frames) do
            local d = (cf.Position - pos).Magnitude
            if d < dist then dist = d; idx = i end
        end
    end
    if idx >= #frames then idx = math.max(1, #frames - 1) end
    return idx
end

local function aw_lerpCF(fromCF, toCF)
    fromCF = aw_applyIntervalRot(fromCF)
    toCF   = aw_applyIntervalRot(toCF)
    local duration = frameTime / math.max(0.05, playbackRate)
    local t = 0
    local done = false
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if not isRunning then conn:Disconnect(); done = true; return end
        if paused then return end
        t = t + dt
        local alpha = math.min(t / duration, 1)
        if aw_hrp and aw_hrp.Parent and aw_hrp:IsDescendantOf(workspace) then
            aw_hrp.CFrame = fromCF:Lerp(toCF, alpha)
        end
        if alpha >= 1 then conn:Disconnect(); done = true end
    end)
    while not done do task.wait() end
end

