local recordedRoute       = nil
local recordedRouteStates = nil   -- table of STA string per frame (opsional, dari JSON)
local recordedTools       = {}    -- {frameIndex = toolName} saat tool berubah

-- Equip tool by name dari Backpack atau Character
local function aw_equipTool(toolName)
    local char    = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack then return end

    -- Cek dulu di character (sudah equipped)
    local current = char:FindFirstChildOfClass("Tool")
    if current and current.Name == toolName then return end

    -- Unequip dulu kalau ada tool lain
    if current then
        humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid:UnequipTools() end
        task.wait(0.05)
    end

    -- Equip dari backpack
    local tool = backpack:FindFirstChild(toolName)
    if tool then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum:EquipTool(tool) end
    end
end

local function aw_unequipAll()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum:UnequipTools() end
end

local function runRecordedRoute()
    if not recordedRoute or #recordedRoute < 2 then return end
    if not aw_hrp then aw_refreshHRP() end
    aw_setBypass(true)
    isRunning = true
    paused    = false
    local savedFrameTime = frameTime
    frameTime = 1/120  -- match record 120fps
    -- Equip tool awal jika ada
    if recordedTools[1] then
        pcall(function() aw_equipTool(recordedTools[1]) end)
    end

    for i = 1, #recordedRoute - 1 do
        if not isRunning then break end
        while paused do task.wait() end
        -- Set state override dari JSON supaya animasi akurat
        if recordedRouteStates then
            currentFrameState = recordedRouteStates[i]
        else
            currentFrameState = nil
        end
        -- Auto equip/unequip tool sesuai rekaman
        if recordedTools[i] ~= nil then
            pcall(function()
                if recordedTools[i] == "" then
                    aw_unequipAll()
                else
                    aw_equipTool(recordedTools[i])
                end
            end)
        end
        pcall(function() aw_lerpCF(recordedRoute[i], recordedRoute[i+1]) end)
    end
    currentFrameState = nil  -- reset setelah selesai
    frameTime = savedFrameTime
    isRunning = false
    aw_setBypass(false)
end

local function stopAllRoutes()
    isRunning    = false
    paused       = false
    loopRoute    = false
    bypassActive = false
end

