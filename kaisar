local function aw_setupBypass(char)
    local hum  = char:WaitForChild("Humanoid")
    local root = char:WaitForChild("HumanoidRootPart")
    local lastPos = root.Position

    if bypassConn then bypassConn:Disconnect() end

    bypassConn = RunService.RenderStepped:Connect(function()
        if not root or not root.Parent then return end

        if bypassActive then
            local dir   = root.Position - lastPos
            local dist  = dir.Magnitude
            local yDiff = root.Position.Y - lastPos.Y

            local stateOverride = currentFrameState
            if stateOverride == "Jumping" or yDiff > 0.5 then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            elseif stateOverride == "Freefall" or yDiff < -1 then
                hum:ChangeState(Enum.HumanoidStateType.Freefall)
            end

            if dist > 0.01 then
                local moveVec = dir.Unit * math.clamp(dist * 5, 0, 1)
                hum:Move(moveVec, false)
            else
                hum:Move(Vector3.zero, false)
            end
        end
        -- Tidak restore WalkSpeed — biarkan game handle sendiri (coil/no coil tetap beda)

        lastPos = root.Position
    end)
end

