                if gui.Name:find("WindUI") or gui.Name:find("KaisarHub") then
                    gui:Destroy()
                end
            end
        end)
        pcall(function()
            local cg = game:GetService("CoreGui"):FindFirstChild("WindUI")
            if cg then cg:Destroy() end
        end)
    end,
})

