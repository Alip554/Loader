local function SafeParent(gui)
    -- Synapse protect -> CoreGui
    if syn and syn.protect_gui then
        pcall(function() syn.protect_gui(gui) end)
        if pcall(function() return game.CoreGui end) then
            gui.Parent = game.CoreGui
            return
        end
    end

    -- gethui (Delta / Fluxus)
    if gethui then
        local ok, res = pcall(function() gui.Parent = gethui() end)
        if ok then return end
    end

    -- Studio / CoreGui access
    if RunService:IsStudio() or pcall(function() return game.CoreGui end) then
        local ok = pcall(function() gui.Parent = game.CoreGui end)
        if ok then return end
    end

    -- fallback PlayerGui
    gui.Parent = player:WaitForChild("PlayerGui")
end

-- ===== DETECT EXECUTOR & PLATFORM =====
local function detectExecutor()
    -- try identifyexecutor
    if identifyexecutor and type(identifyexecutor) == "function" then
        local ok, out = pcall(identifyexecutor)
        if ok and out and out ~= "" then return tostring(out) end
    end

    -- common globals / flags
    if syn and syn.request then return "Synapse X" end
    if Krnl or KRNL or krnl then return "Krnl" end
    if secure_load then return "Script-Ware/SirHurt-like" end
    if fluxus then return "Fluxus" end
    if rawget(_G, "DELTA_LOADED") ~= nil or rawget(_G, "Delta") ~= nil or rawget(_G, "delta") ~= nil then return "Delta" end
    if PROTOSMASHER_LOADED or pebc_execute then return "ProtoSmasher/PeBC" end
    if getexecutor and type(getexecutor) == "function" then
        local ok, out = pcall(getexecutor)
        if ok and out and out ~= "" then return tostring(out) end
    end
    if request or http_request then return "Request-compatible Executor" end
    if http and http.request then return "HTTP-capable Executor (unknown)" end

    return "Unknown/RobloxNative"
end

local function detectPlatform()
    local ok, UserInputService = pcall(function() return game:GetService("UserInputService") end)
    if not ok or not UserInputService then return "Unknown" end
    local success, p = pcall(function()
        if UserInputService.GetPlatform then
            return tostring(UserInputService:GetPlatform())
        else
            local parts = {}
            if UserInputService.TouchEnabled then table.insert(parts, "Touch") end
            if UserInputService.KeyboardEnabled then table.insert(parts, "Keyboard") end
            if #parts == 0 then return "Unknown" end
            return table.concat(parts, "/")
        end
    end)
    if success and p then return p end
    return "Unknown"
end

-- ===== TRY FETCH IP (BEST-EFFORT, REQUIRES EXECUTOR REQUEST) =====
local function tryFetchIP(req)
    if not req then return nil end
    local urls = {
        "https://ipinfo.io/json",
        "https://api.ipify.org?format=json",
        "https://ifconfig.me/all.json"
    }
    for _, url in ipairs(urls) do
        local ok, res = pcall(function()
            local r = req({Url = url, Method = "GET", Headers = { ["User-Agent"] = "Mozilla/5.0" }})
            return (r and (r.Body or r.body)) or nil
        end)
        if ok and res and #tostring(res) > 0 then
            local successJson, parsed = pcall(function() return HttpService:JSONDecode(res) end)
            if successJson and type(parsed) == "table" then
                return parsed
            else
                return { ip = tostring(res):match("%d+%.%d+%.%d+%.%d+") or tostring(res), raw = res }
            end
        end
    end
    return nil
end

