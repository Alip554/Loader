local function createRecordTab()
    local RTab = Window:Tab({
        Title = "Record",
        Icon  = "circle-dot",
    })

    RTab:Section({ Title = "KaisarHub | Record Route" })
    RTab:Space()

    local recordNameValue = "MyRoute"

    -- Dropdown file lokal
    local localRouteFiles = {"(kosong)"}
    local folder = "kaisarhub/routes"
    if isfolder and isfolder(folder) then
        local files = listfiles(folder)
        for _, f in ipairs(files) do
            local n = f:match("([^/\\]+)%.[lt][xu][ta]$")
            if n then table.insert(localRouteFiles, n) end
        end
    end

    RTab:Dropdown({
        Title    = "File Lokal",
        Desc     = "Pilih route hasil rekaman kamu",
        Icon     = "hard-drive",
        Values   = localRouteFiles,
        Default  = localRouteFiles[1],
        Callback = function(val)
            if val ~= "(kosong)" then
                recordNameValue = val
            end
        end,
    })

    RTab:Input({
        Title       = "Nama Route",
        Desc        = "Nama untuk menyimpan route hasil rekaman",
        Icon        = "pencil",
        Placeholder = "Contoh: MyRoute",
        Default     = "MyRoute",
        Callback    = function(val)
            if val and val ~= "" then
                recordNameValue = val
            end
        end,
    })

    RTab:Toggle({
        Title    = "Record",
        Desc     = "ON = mulai rekam, OFF = selesai & simpan",
        Icon     = "circle-dot",
        Type     = "Checkbox",
        Value    = false,
        Callback = function(state)
            if state then
                isRecording = true
                recordedFrames = {}
                recordedTools  = {}
                local lastRecord = 0
                if recordConn then recordConn:Disconnect() end
                local lastToolName = ""
                recordConn = game:GetService("RunService").RenderStepped:Connect(function()
                    local now = tick()
                    if now - lastRecord < 1/120 then return end
                    lastRecord = now
                    if aw_hrp and aw_hrp.Parent then
                        local frameIdx = #recordedFrames + 1
                        table.insert(recordedFrames, aw_hrp.CFrame)

                        -- Cek tool yang sedang dipegang
                        local char = LocalPlayer.Character
                        local tool = char and char:FindFirstChildOfClass("Tool")
                        local toolName = tool and tool.Name or ""
                        if toolName ~= lastToolName then
                            recordedTools[frameIdx] = toolName  -- catat perubahan
                            lastToolName = toolName
                        end
                    end
                end)
                WindUI:Notify({ Title = "Record", Content = "Perekaman dimulai! Jalan sekarang.", Icon = "circle-dot", Duration = 3 })
            else
                isRecording = false
                if recordConn then
                    recordConn:Disconnect()
                    recordConn = nil
                end
                if #recordedFrames >= 2 then
                    local cleaned = aw_removeDuplicates(recordedFrames, 0.01)
                    recordedFrames = {}
                    recordedRoute = cleaned
                    recordedRouteStates = nil
                    -- recordedTools sudah terisi saat record, tidak perlu reset

                    local routeName = recordNameValue ~= "" and recordNameValue or "MyRoute"
                    local folder = "kaisarhub/routes"
                    if not isfolder("kaisarhub") then makefolder("kaisarhub") end
                    if not isfolder(folder) then makefolder(folder) end

                    local lines = {"return {"}
                    for _, cf in ipairs(cleaned) do
                        local p = cf.Position
                        local rx, ry, rz = cf:ToEulerAnglesXYZ()
                        lines[#lines+1] = string.format(
                            "    CFrame.new(%.15f,%.15f,%.15f) * CFrame.Angles(%.15f,%.15f,%.15f),",
                            p.X, p.Y, p.Z, rx, ry, rz
                        )
                    end
                    lines[#lines+1] = "}"
                    writefile(folder .. "/" .. routeName .. ".lua", table.concat(lines, "\n"))

                    WindUI:Notify({ Title = "Tersimpan!", Content = routeName .. " siap diplay.", Icon = "check", Duration = 4 })
                else
                    recordedFrames = {}
                end
            end
        end,
    })

    RTab:Space()

    RTab:Button({
        Title    = "Play Record",
        Desc     = "Jalankan route hasil rekaman dari awal",
        Icon     = "play",
        Callback = function()
            if not recordedRoute or #recordedRoute < 2 then
                WindUI:Notify({ Title = "Belum Ada Record", Content = "Lakukan rekaman dulu!", Icon = "shield-x", Duration = 3 })
                return
            end
            WindUI:Notify({ Title = "Play Record", Content = "Menjalankan route rekaman...", Icon = "play", Duration = 3 })
            task.spawn(runRecordedRoute)
        end,
    })

    RTab:Button({
        Title    = "Stop",
        Desc     = "Hentikan playback route rekaman",
        Icon     = "square",
        Callback = function()
            stopAllRoutes()
            WindUI:Notify({ Title = "Stop", Content = "Playback dihentikan.", Icon = "square", Duration = 3 })
        end,
    })

    RTab:Space()

    RTab:Button({
        Title    = "Refresh & Load Route Lokal",
        Desc     = "Ketik nama route di input lalu klik untuk load",
        Icon     = "folder-open",
        Callback = function()
            local folder = "kaisarhub/routes"
            if not isfolder(folder) then
                WindUI:Notify({ Title = "Kosong", Content = "Belum ada route tersimpan.", Icon = "shield-x", Duration = 3 })
                return
            end
            local routeName = recordNameValue ~= "" and recordNameValue or "MyRoute"
            local path = folder .. "/" .. routeName .. ".json"
            local isJson = true
            if not isfile(path) then
                isJson = false
                path = folder .. "/" .. routeName .. ".lua"
            end
            if not isfile(path) then
                path = folder .. "/" .. routeName .. ".txt"
            end
            if not isfile(path) then
                local files = listfiles(folder)
                local names = {}
                for _, f in ipairs(files) do
                    local n = f:match("([^/\\]+)%.[ljt][su][ao]n?$")
                    if n then table.insert(names, n) end
                end
                local hint = #names > 0 and ("Ada: " .. table.concat(names, ", ")) or "Folder kosong."
                WindUI:Notify({ Title = "Tidak Ditemukan", Content = routeName .. " tidak ada.\n" .. hint, Icon = "shield-x", Duration = 5 })
                return
            end

            local frames
            local states = nil

            if isJson then
                local ok, parsed = pcall(function()
                    return game:GetService("HttpService"):JSONDecode(readfile(path))
                end)
                if ok and type(parsed) == "table" and #parsed >= 2 then
                    frames = {}
                    states = {}
                    for _, entry in ipairs(parsed) do
                        local pos = entry.POS or entry.position
                        local rot = entry.ROT or entry.rotation
                        local sta = entry.STA or entry.state or "Running"
                        if pos then
                            local px = pos.x or pos.X or 0
                            local py = pos.y or pos.Y or 0
                            local pz = pos.z or pos.Z or 0
                            table.insert(frames, CFrame.new(px, py, pz) * CFrame.Angles(0, rot or 0, 0))
                            table.insert(states, sta)
                        end
                    end
                end
            elseif path:match("%.lua$") then
                local ok, result = pcall(function()
                    return loadstring(readfile(path))()
                end)
                if ok and type(result) == "table" then
                    frames = result
                end
            else
                frames = {}
                for line in readfile(path):gmatch("[^\n]+") do
                    local x,y,z,rx,ry,rz = line:match("([^,]+),([^,]+),([^,]+),([^,]+),([^,]+),([^,]+)")
                    if x then
                        table.insert(frames, CFrame.new(tonumber(x),tonumber(y),tonumber(z))
                            * CFrame.Angles(tonumber(rx),tonumber(ry),tonumber(rz)))
                    end
                end
            end

            if frames and #frames >= 2 then
                recordedRoute = aw_adjustRoute(frames)
                recordedRouteStates = states
                local fmt = isJson and " (JSON+STA)" or ""
                WindUI:Notify({ Title = "Loaded!", Content = routeName .. fmt .. " siap diplay.", Icon = "check", Duration = 3 })
            else
                WindUI:Notify({ Title = "Error", Content = "File rusak atau kosong.", Icon = "shield-x", Duration = 3 })
            end
        end,
    })
end
